{
  "name": "@surgio/packages-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "turbo run test",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "coverage": "turbo run test:cov",
    "test:e2e": "pnpm --filter @surgio/gateway test:e2e",
    "test:types": "run-s test:types:ts6 test:types:ts7",
    "test:types:ts6": "tsc6 --noEmit -p packages/gateway/tsconfig.json && tsc6 --noEmit -p packages/gateway-frontend/tsconfig.json && tsc6 --noEmit -p packages/logger/tsconfig.json && tsc6 --noEmit -p test/fixture/typescript-consumer/tsconfig.json",
    "test:types:ts7": "tsc --noEmit -p packages/gateway/tsconfig.json && tsc --noEmit -p packages/gateway-frontend/tsconfig.json && tsc --noEmit -p packages/logger/tsconfig.json && tsc --noEmit -p test/fixture/typescript-consumer/tsconfig.json",
    "test:package-output": "vitest run --config vitest.package-output.config.mts",
    "prepublishOnly": "turbo run build",
    "lerna": "lerna",
    "prepare": "husky install",
    "release": "lerna version && lerna publish from-git",
    "release:beta": "lerna version --preid beta && lerna publish from-git --dist-tag beta"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-angular": "^17.8.1",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.20.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-istanbul": "^4.1.10",
    "chokidar": "^4.0.3",
    "conventional-changelog-cli": "^2.2.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "execa": "^4.1.0",
    "globals": "^16.0.0",
    "husky": "^8.0.3",
    "jsdom": "^27.0.0",
    "lerna": "^6.6.2",
    "lint-staged": "^13.3.0",
    "nock": "^13.5.6",
    "npm-debug-log-cleaner": "^1.0.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "rimraf": "^5.0.10",
    "surgio": "^3.12.2",
    "ts-node": "^10.9.2",
    "turbo": "^1.13.4",
    "type-fest": "^3.13.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "repository": "https://github.com/surgioproject/packages",
  "author": "Roy Li <me@royli.dev>",
  "bugs": {
    "url": "https://github.com/surgioproject/surgio/issues"
  },
  "homepage": "https://surgio.js.org",
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -c .commitlintrc.json -E HUSKY_GIT_PARAMS",
      "pre-commit": "npm-debug-log-cleaner && lint-staged"
    }
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
