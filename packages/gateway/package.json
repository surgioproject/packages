{
  "name": "@surgio/gateway",
  "description": "Surgio API Gateway 面板",
  "private": false,
  "license": "MIT",
  "version": "2.4.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module-sync": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": "./*"
  },
  "repository": "https://github.com/surgioproject/packages/tree/master/packages/gateway",
  "author": "Roy Li <me@royli.dev>",
  "bugs": {
    "url": "https://github.com/surgioproject/surgio/issues"
  },
  "homepage": "https://surgio.js.org",
  "scripts": {
    "prebuild": "rimraf dist *.tsbuildinfo",
    "build": "nest build -p tsconfig.build.json",
    "start": "nest start",
    "start:prod": "node dist/main",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "lint": "eslint .",
    "test": "run-s test:ci",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:ci": "run-s test:unit test:e2e"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/serve-static": "^5.0.5",
    "@surgio/gateway-frontend": "workspace:*",
    "bluebird": "^3.7.2",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.21",
    "express": "^5.2.1",
    "fs-extra": "^11.4.0",
    "http-errors": "^2.0.1",
    "lodash": "^4.18.1",
    "nunjucks": "^3.2.4",
    "passport": "^0.7.0",
    "passport-cookie": "^1.0.9",
    "passport-http-bearer": "^1.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "serverless-http": "^4.0.0",
    "source-map-support": "^0.5.21",
    "youch": "^4.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@types/bluebird": "^3.5.42",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.25",
    "@types/nunjucks": "^3.2.6",
    "@types/passport": "^1.0.17",
    "@types/supertest": "^7.2.1",
    "nock": "^14.0.17",
    "sinon": "^22.1.0",
    "supertest": "^7.2.2",
    "tsconfig-paths": "^4.2.0"
  },
  "peerDependencies": {
    "surgio": "^4.0.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "gitHead": "da96fe077b24097d0a721392bd32ec4a88ac2ee0"
}
